{
  "name": "@acme/dh-mock",
  "private": true,
  "version": "0.1.0",
  "description": "A Deephaven server in the page, for demos, offline work and tests: a mock update graph and JS API, the request-API protocol, and a mock of dh_chart_ext's chart server (chart nodes, studies, stores, backtests) over an app's market",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@acme/chart-ext": "^0.4.0"
  },
  "devDependencies": {
    "lightweight-charts": "5.2.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
