{
  "name": "@acme/dh-bindings",
  "private": true,
  "version": "0.3.0",
  "description": "Deephaven bindings for @acme/chart-ext: stores over input tables, row subscriptions, table feeds, and the request client for the server's API",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@acme/chart-ext": "^0.5.0",
    "@deephaven/jsapi-types": "~41.11.0",
    "lightweight-charts": "5.2.0"
  },
  "devDependencies": {
    "@deephaven/jsapi-types": "~41.11.0",
    "lightweight-charts": "5.2.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "@acme/chart-ext": {
      "optional": true
    }
  }
}
