{
  "name": "@acme/chart-react",
  "private": true,
  "version": "0.4.0",
  "description": "React components for trading charts, styled like TradingView: toolbar (symbol search, interval, chart type, indicators, layouts), legend with study settings, watchlist",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "lightweight-charts": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "lightweight-charts": "5.2.0",
    "react": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  },
  "peerDependenciesMeta": {
    "lightweight-charts": {
      "optional": true
    }
  }
}
