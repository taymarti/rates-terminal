{
  "name": "@acme/app-shell",
  "private": true,
  "version": "0.2.0",
  "description": "Layer 3: an app shell for Deephaven-backed desk apps: dockable panels (dockview), saved workspaces, link groups, the Deephaven connection as React context, and generic panels (chart, table, forms)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/app-shell.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "dockview-react": "8.8.3"
  },
  "peerDependencies": {
    "@acme/chart-ext": "^0.5.0",
    "@acme/chart-react": "^0.5.0",
    "@acme/dh-bindings": "^0.3.0",
    "@deephaven/jsapi-types": "~41.11.0",
    "lightweight-charts": "5.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@acme/chart-ext": {
      "optional": true
    },
    "@acme/chart-react": {
      "optional": true
    },
    "@acme/dh-bindings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deephaven/jsapi-types": "~41.11.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "lightweight-charts": "5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
