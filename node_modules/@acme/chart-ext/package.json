{
  "name": "@acme/chart-ext",
  "private": true,
  "version": "0.4.0",
  "description": "The chart component: our features as Lightweight Charts plugins, their storage and data interfaces, and the hook that applies them to Deephaven TradingView charts. No Deephaven dependency.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@tradingview/lwc-plugin-user-price-lines": "1.0.0"
  },
  "peerDependencies": {
    "lightweight-charts": "5.2.0"
  },
  "devDependencies": {
    "lightweight-charts": "5.2.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
