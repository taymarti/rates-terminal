{
  "name": "@acme/dh-widgets",
  "private": true,
  "version": "0.1.0",
  "description": "Deephaven's own widgets (deephaven.ui, plotly express, the TradingView plugin: anything a server plugin renders) in a React page and in @acme/app-shell panels, outside Deephaven's IDE",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./widgets": {
      "types": "./dist/types/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./remote-module-loader": {
      "types": "./dist/types/remote-module-loader.d.ts",
      "import": "./dist/remote-module-loader.js"
    },
    "./style.css": "./dist/dh-widgets.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@acme/app-shell": "^0.1.0",
    "@acme/dh-bindings": "^0.2.0",
    "@deephaven/app-utils": "^1.31.0",
    "@deephaven/components": "^1.30.0",
    "@deephaven/dashboard": "^1.30.0",
    "@deephaven/jsapi-bootstrap": "^1.30.0",
    "@deephaven/plugin": "^1.31.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@deephaven/app-utils": "1.31.0",
    "@deephaven/components": "1.30.0",
    "@deephaven/dashboard": "1.30.0",
    "@deephaven/jsapi-bootstrap": "1.30.0",
    "@deephaven/jsapi-types": "~41.11.0",
    "@deephaven/plugin": "1.31.0",
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
