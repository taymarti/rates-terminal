    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@tanstack/react-virtual": "^3.13.12",
    "classnames": "^2.3.1",
    "fast-deep-equal": "^3.1.3",
    "lodash.clamp": "^4.0.3",
    "lodash.debounce": "^4.0.8",
