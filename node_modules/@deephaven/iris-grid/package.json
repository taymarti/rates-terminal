  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deephaven/jsapi-shim": "^1.9.0",
    "@deephaven/mocks": "^1.1.0",
    "@deephaven/test-utils": "^1.8.0",
