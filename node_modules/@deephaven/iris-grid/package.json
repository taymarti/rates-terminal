    "@deephaven/jsapi-types": "^1.0.0-dev0.40.4",
    "@deephaven/jsapi-utils": "^1.29.0",
    "@deephaven/log": "^1.8.0",
    "@deephaven/react-hooks": "^1.30.0",
    "@deephaven/storage": "^1.8.0",
    "@deephaven/utils": "^1.29.0",
