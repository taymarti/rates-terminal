    "build:sass": "sass --embed-sources --load-path=../../node_modules ./src:./dist"
  },
  "dependencies": {
    "@deephaven/components": "^1.30.0",
    "@deephaven/icons": "^1.2.0",
    "@deephaven/log": "^1.8.0",
