    "@types/js-cookie": "^3.0.3",
    "classnames": "^2.3.2",
    "js-cookie": "^3.0.5",
    "lodash.debounce": "^4.0.8"
  },
  "devDependencies": {
    "@deephaven/jsapi-shim": "^1.9.0",
